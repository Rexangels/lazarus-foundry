# Django & Localhost Infrastructure (PostgreSQL & Redis running via docker-compose)
DEBUG=True
SECRET_KEY=lazarus-foundry-kiroween-dev-secret-key-change-in-prod
DATABASE_URL=postgres://lazarus:lazarus_secret@localhost:5432/lazarus
REDIS_URL=redis://localhost:6379/0
# Close telemetry WebSockets for unknown project IDs with code 4404 (True) or skip the DB lookup (False).
TELEMETRY_REQUIRE_EXISTING_PROJECT=True

# Reasoning model (OpenAI-compatible endpoint). Current provider for testing: Meta Model API.
# MODEL_ID options: muse-spark-1.3 (recommended, GA) or muse-wonder-1.0 (preview).
MODEL_API_KEY=your_meta_model_api_key_here
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
# Optional `reasoning_effort` for the model (e.g. low, medium, high). Empty = not sent.
MODEL_REASONING_EFFORT=
# Per-request timeout (seconds) and SDK retries for reasoning-model calls.
MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=1
# Genome synthesis. An empty MODEL_API_KEY gives the deterministic genome (mode DETERMINISTIC);
# with a key, the model refines it and any model failure falls back (mode MODEL_FALLBACK).
# Most evidence-catalog items sent to the model per request (the draft's citations go first).
GENOME_MAX_CATALOG_ITEMS=400
# Celery soft/hard time limits for synthesize_genome_task (not enforced by --pool=solo).
GENOME_TASK_SOFT_TIME_LIMIT_SECONDS=900
GENOME_TASK_TIME_LIMIT_SECONDS=960

# Revival approval gate. The API has no authentication yet. True = approving a strategy also requires
# the header "X-Lazarus-Approver: <name>" (stored as the approver). A minimal gate for a hosted demo,
# not authentication: anyone who can reach the API can send the header.
REVIVAL_APPROVAL_REQUIRES_HEADER=False

# Sandbox execution (apps/foundry/sandbox.py).
# "docker": hardened containers (non-root, read-only root fs, no network while repository code runs).
#           The only mode allowed for repositories you did not build yourself. Needs Docker Desktop.
# "subprocess": a local venv on this machine with NO isolation. Allowed only for the golden demo
#           (PayPulse) unless SANDBOX_ALLOW_SUBPROCESS_FOR_UNTRUSTED=True.
SANDBOX_MODE=subprocess
# Preview server port; only ever published on 127.0.0.1, and only when a preview is requested.
SANDBOX_PREVIEW_PORT=8010
# Keep WORKSPACE_ROOT and SANDBOX_RUNS_ROOT out of OneDrive/Dropbox-synced folders when you can
# (Docker Desktop bind mounts of synced folders are slow and can fail; see README).
WORKSPACE_ROOT=./.lazarus_data/workspaces
FIXTURE_ROOT=./.lazarus_data/fixtures
# Per-run directories (subprocess venvs, JUnit results, sandbox HOME/TMP). Must not overlap WORKSPACE_ROOT.
SANDBOX_RUNS_ROOT=./.lazarus_data/sandbox_runs
# Docker image per Python version; {version} is one of SANDBOX_PYTHON_VERSIONS.
SANDBOX_DOCKER_IMAGE_TEMPLATE=python:{version}-slim
# Python versions the EnvironmentAgent may request (comma-separated), and the default.
SANDBOX_PYTHON_VERSIONS=3.8,3.9,3.10,3.11,3.12,3.13
SANDBOX_DEFAULT_PYTHON=3.11
# Docker limits per container: memory (no swap on top), CPUs and process count.
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
# Default timeouts (seconds) for a sandbox command and for a dependency install. On timeout the
# container (Docker) or the whole process tree (subprocess) is killed.
SANDBOX_COMMAND_TIMEOUT_SECONDS=600
SANDBOX_INSTALL_TIMEOUT_SECONDS=900
# Bytes of stdout and of stderr kept per command (each); longer output is truncated and flagged.
SANDBOX_MAX_OUTPUT_BYTES=1048576
# DANGER: True runs ANY repository's code directly on this machine in subprocess mode, with no
# network, filesystem or process isolation and access to everything your user account can read.
SANDBOX_ALLOW_SUBPROCESS_FOR_UNTRUSTED=False

# Ingestion (Git forensics)
# Hosts accepted for submitted repository URLs (https:// only, comma-separated, exact match).
INGEST_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
# An unmerged branch is "abandoned" when its last commit is at least this many days
# older than the repository's newest commit (measured on the repo's own timeline).
ABANDONED_BRANCH_MIN_AGE_DAYS=90
# Per-file cap (bytes) on the unified patch kept for each branch diff; longer patches are truncated.
INGEST_MAX_PATCH_BYTES=65536
# Clone timeout in seconds.
INGEST_CLONE_TIMEOUT_SECONDS=600

# Ingestion (AST and document extraction)
# Files larger than this many bytes are skipped (recorded as SKIPPED_TOO_LARGE). Default 512 KiB.
INGEST_MAX_PARSE_BYTES=524288
# Python always uses the bundled grammar. Other languages come from tree-sitter-language-pack,
# which downloads grammars on first use. False = use only grammars already in its local cache
# (pre-fetch with: python -c "import tree_sitter_language_pack as p; p.download(['javascript'])").
INGEST_ALLOW_GRAMMAR_DOWNLOAD=False

# Ingestion (pipeline and Celery task)
# Cap (bytes) on the file text / branch diff stored in each ArtifactRecord.raw_content. Default 256 KiB.
INGEST_MAX_STORED_CONTENT_BYTES=262144
# Celery soft/hard time limits for ingest_repository_task (soft must be below hard).
# The Windows --pool=solo worker does not enforce them; INGEST_CLONE_TIMEOUT_SECONDS still applies.
INGEST_TASK_SOFT_TIME_LIMIT_SECONDS=1800
INGEST_TASK_TIME_LIMIT_SECONDS=1860

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws
