# Copy to frontend/.env.local. Next.js reads env files from this folder, not the repository root.

# REST base, including /api. The backend sends no CORS headers, so a browser on :3000 cannot read
# direct responses from :8000. Use "/api" to go through the Next.js proxy (next.config.ts) instead.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Where the /api proxy forwards to (only used when NEXT_PUBLIC_API_BASE_URL=/api). Read at build/start time.
LAZARUS_BACKEND_ORIGIN=http://localhost:8000

# Telemetry WebSocket base, including /ws. WebSockets are not proxied.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws

# 1 = serve every screen from the recorded PayPulse run in src/lib/mock/ (no backend needed).
NEXT_PUBLIC_DEMO_MOCK=0
